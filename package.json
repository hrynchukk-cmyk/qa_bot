{
  "name": "qa-design-bot",
  "version": "0.1.0",
  "description": "Бот для автоматичного тестування верстки сайтів на різних розширеннях екрана з опційним порівнянням із Figma-макетом",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "qa-bot": "bin/qa-bot.js"
  },
  "scripts": {
    "start": "node src/server/index.js",
    "demo": "node scripts/demo.js",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=18.17"
  },
  "keywords": [
    "qa",
    "testing",
    "responsive",
    "layout",
    "figma",
    "playwright"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0",
    "express": "^4.22.2",
    "pixelmatch": "^5.3.0",
    "playwright": "^1.56.0",
    "pngjs": "^7.0.0"
  }
}
